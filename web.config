<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404"/><error statusCode="404" path="/404.html" responseMode="File"/>
      <remove statusCode="500"/><error statusCode="500" path="/500.html" responseMode="File"/>
    </httpErrors>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"/>
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".webmanifest"/>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/>
      <remove fileExtension=".webp"/>
      <mimeMap fileExtension=".webp" mimeType="image/webp"/>
    </staticContent>
  </system.webServer>
</configuration>
