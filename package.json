{
  "name": "outside-in-website-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outside In — a public website audit for availability, search, accessibility, performance, and security signals.",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "icons": "node scripts/create-icons.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
